{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webnuvola/laravel-active",
    "description": "Helper functions for Laravel applications to get active class based on current route",
    "keywords": ["laravel", "active", "menu", "current"],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabio Cagliero"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.0||^4.7"
    },
    "autoload": {
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Webnuvola\\Laravel\\Active\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
